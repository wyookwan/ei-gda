# Copy to .env on the deployment server. Never commit .env.
SECRET_KEY=replace-with-a-long-random-secret
MYSQL_DB=eigda_db
MYSQL_USER=eigda_user
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
MYSQL_HOST=db
MYSQL_PORT=3306
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=5000
DEBUG=False
AUTO_MIGRATE=True
WEB_WORKERS=2
WEB_THREADS=4
WEB_TIMEOUT=1800
# Open -> Google Gemini. Supply your authorized API key/model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=120
# Confidential -> your reachable Local Model endpoint.
LOCAL_MODEL_API_URL=http://your-model-server:8087/v1/chat/completions
LOCAL_MODEL_NAME=google/gemma-4-31B-it-qat-w4a16-ct
LOCAL_MODEL_API_MODE=openai_chat
LOCAL_MODEL_TIMEOUT=180
LOCAL_MODEL_BATCH_SIZE=10
LOCAL_MODEL_MAX_TOKENS=3500
# Raise with LOCAL_MODEL_MAX_TOKENS for reasoning models with a large context window.
LOCAL_MODEL_TOKEN_CAP=3500
LOCAL_MODEL_VERIFY_SSL=True
THAID_ENABLED=False
THAID_DISCOVERY_URL=
THAID_AUTHORIZATION_ENDPOINT=
THAID_TOKEN_ENDPOINT=
THAID_USERINFO_ENDPOINT=
THAID_CLIENT_ID=
THAID_CLIENT_SECRET=
THAID_API_KEY=
THAID_API_KEY_HEADER=x-api-key
THAID_SCOPE=pid openid name_en name
THAID_REDIRECT_URI=
THAID_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
THAID_VERIFY_SSL=True

# Only used when creating demonstration users on first seed. Set strong secrets.
EIGDA_ADMIN_PASSWORD=
EIGDA_COMMITTEE_PASSWORD=

# V16
# Optional shortcut username for the first admin account. Leave empty to disable.
ADMIN_LOGIN_ALIAS=
# Set True when the site is served over HTTPS.
SESSION_COOKIE_SECURE=False

# MHESI pilot
# Use a separate database for DEMO, e.g. sqlite:////srv/eigda/demo/pilot_demo.db. Empty = MySQL settings above.
DATABASE_URL=
# True shows DEMO labels on approvals and seeded records. Never True on a production database.
DEMO_MODE=False
# Disclosure classes this host may store. 'secret' (official secret classes) is never supported.
SUPPORTED_DISCLOSURE_CLASSES=public,internal,restricted
MAX_PDF_PAGES=400
# Set True only after confirming disk/volume encryption for the database and uploads folder (docs/PILOT_DEPLOY.md).
ENCRYPTION_AT_REST_CONFIRMED=False
