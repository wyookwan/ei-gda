# Ei-GDA V14 - Example configuration
# Copy to .env and replace passwords / ThaiD credentials before deployment.

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=eigda_db
MYSQL_USER=eigda_user
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME

APP_HOST=127.0.0.1
APP_PORT=5000
DEBUG=True
UPLOAD_FOLDER=uploads
REPORT_FOLDER=reports
AUTO_MIGRATE=True

# OPEN documents -> Gemini. Never commit a real API key.
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=120

# CONFIDENTIAL documents -> Local Model.
# No API key / Authorization header is sent.
LOCAL_MODEL_API_URL=http://10.80.39.43:8087/v1/chat/completions
LOCAL_MODEL_NAME=google/gemma-4-31B-it-qat-w4a16-ct
LOCAL_MODEL_API_MODE=openai_chat
LOCAL_MODEL_TIMEOUT=180
LOCAL_MODEL_BATCH_SIZE=10
LOCAL_MODEL_MAX_TOKENS=3500
LOCAL_MODEL_VERIFY_SSL=False

# ThaiD OAuth2 / OpenID Connect (optional)
THAID_ENABLED=False
THAID_DISCOVERY_URL=https://imauth.bora.dopa.go.th/.well-known/openid-configuration
THAID_AUTHORIZATION_ENDPOINT=https://imauth.bora.dopa.go.th/api/v2/oauth2/auth/
THAID_TOKEN_ENDPOINT=https://imauth.bora.dopa.go.th/api/v2/oauth2/token/
THAID_USERINFO_ENDPOINT=
THAID_INTROSPECT_URL=https://imauth.bora.dopa.go.th/api/v2/oauth2/introspect/
THAID_REVOKE_URL=https://imauth.bora.dopa.go.th/api/v2/oauth2/revoke/
THAID_API_KEY=CHANGE_ME
THAID_CLIENT_ID=CHANGE_ME
THAID_CLIENT_SECRET=CHANGE_ME
THAID_API_KEY_HEADER=x-api-key
THAID_SCOPE=pid openid name_en name
THAID_REDIRECT_URI=http://127.0.0.1:5000/auth/thaid/callback
THAID_TOKEN_ENDPOINT_AUTH_METHOD=client_secret_basic
THAID_ORGANIZATION_DEFAULT=Burapha University
THAID_VERIFY_SSL=True
